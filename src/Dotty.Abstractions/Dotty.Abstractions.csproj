<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>12.0</LangVersion>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Dotty.Abstractions</PackageId>
    <!-- Version is set in Directory.Build.props -->
    <Authors>Dominic Codespoti</Authors>
    <Description>Configuration abstractions and themes for Dotty terminal emulator</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dominic-codespoti/dotty</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dominic-codespoti/dotty</PackageProjectUrl>
    <PackageTags>terminal;console;cli;config;themes;dotty</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- No separate symbol package: DebugType=embedded (Directory.Build.props)
         already ships debug info inside the DLL, so no standalone .pdb exists
         for a .snupkg to contain. -->
  </PropertyGroup>
  <!-- Embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Themes\themes.json">
      <LogicalName>Dotty.Abstractions.Themes.themes.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
