<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dotty.Terminal\Dotty.Terminal.csproj" />
    <ProjectReference Include="..\..\src\Dotty.App\Dotty.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Avalonia packages are required for types like Typeface/GlyphTypeface used indirectly by the app code. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Avalonia headless testing for UI tests -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="nvim_capture.typescript" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
