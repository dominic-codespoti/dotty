<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Assembly info stays generated: DottyVersion reads the informational version the SDK derives from the central <Version>.
         (AssemblyAttribute items are ignored when GenerateAssemblyInfo is false.) -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dotty.Abstractions\Dotty.Abstractions.csproj" />
    <ProjectReference Include="..\Dotty.Terminal\Dotty.Terminal.csproj" />
    <ProjectReference Include="..\Dotty.NativePty\Dotty.NativePty.csproj" />
    <ProjectReference Include="..\Dotty.Rendering.Gpu\Dotty.Rendering.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KeraLua" />
  </ItemGroup>
</Project>
