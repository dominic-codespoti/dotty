<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dotty</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <!-- NativeAOT is required for bulk-output throughput; verified with the
         headless OpenGL initialization smoke test. -->
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <!-- Use the portable NativeAOT CPU baseline. Local benchmarks may opt in
         explicitly with -p:IlcInstructionSet=native. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dotty.Abstractions\Dotty.Abstractions.csproj" />
    <ProjectReference Include="..\Dotty.Terminal\Dotty.Terminal.csproj" />
    <ProjectReference Include="..\Dotty.NativePty\Dotty.NativePty.csproj" />
    <ProjectReference Include="..\Dotty.Rendering.Gpu\Dotty.Rendering.Gpu.csproj" />
    <ProjectReference Include="..\Dotty.Runtime\Dotty.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../shell-integration/*"
             Link="shell-integration/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <GlfwRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</GlfwRid>
    <GlfwRid Condition="'$(GlfwRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</GlfwRid>
    <GlfwLibraryName Condition="$([System.String]::Copy('$(GlfwRid)').StartsWith('linux-'))">libglfw.so.3</GlfwLibraryName>
    <GlfwLibraryName Condition="$([System.String]::Copy('$(GlfwRid)').StartsWith('win-'))">glfw3.dll</GlfwLibraryName>
    <GlfwLibraryName Condition="$([System.String]::Copy('$(GlfwRid)').StartsWith('osx-'))">libglfw.3.dylib</GlfwLibraryName>
    <Python3Command Condition="$([MSBuild]::IsOSPlatform('Windows'))">python</Python3Command>
    <Python3Command Condition="!$([MSBuild]::IsOSPlatform('Windows'))">python3</Python3Command>
    <GlfwOutputDirectory>$(MSBuildProjectDirectory)/../../obj/native/glfw/$(GlfwRid)/output</GlfwOutputDirectory>
    <GlfwSourceLibrary>$(GlfwOutputDirectory)/$(GlfwLibraryName)</GlfwSourceLibrary>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(GlfwSourceLibrary)"
             Link="$(GlfwLibraryName)"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="RequireGlfwRid" BeforeTargets="Build;Publish" Condition="'$(GlfwRid)' == ''">
    <Error Text="Could not determine the host or target RID required to build pinned GLFW." />
  </Target>
  <Target Name="BuildPinnedGlfw" BeforeTargets="Build;Publish;GetCopyToOutputDirectoryItems" Condition="'$(GlfwRid)' != ''">
    <Exec Command="$(Python3Command) &quot;$(MSBuildProjectDirectory)/../../scripts/native/build-glfw.py&quot; --rid &quot;$(GlfwRid)&quot; --output-dir &quot;$(GlfwOutputDirectory)&quot;" />
  </Target>
  <Target Name="CopyPinnedGlfwToBuildOutput" AfterTargets="Build" Condition="'$(GlfwRid)' != ''">
    <ItemGroup>
      <_ExistingGlfwCopy Include="$(TargetDir)libglfw*;$(TargetDir)glfw3.dll" />
    </ItemGroup>
    <Delete Files="@(_ExistingGlfwCopy)" />
    <Copy SourceFiles="$(GlfwSourceLibrary)" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="CopyPinnedGlfwToPublishOutput" AfterTargets="Publish" Condition="'$(GlfwRid)' != ''">
    <ItemGroup>
      <_ExistingGlfwPublishCopy Include="$(PublishDir)libglfw*;$(PublishDir)glfw3.dll" />
    </ItemGroup>
    <Delete Files="@(_ExistingGlfwPublishCopy)" />
    <Copy SourceFiles="$(GlfwSourceLibrary)" DestinationFolder="$(PublishDir)" />
  </Target>
  <Target Name="CopyUnixPtyHelperToPublish"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <PtyHelperSource>$(MSBuildProjectDirectory)/../Dotty.NativePty/bin/pty-helper</PtyHelperSource>
    </PropertyGroup>
    <Error Condition="'$(RequireUnixPtyHelper)' == 'true' And !Exists('$(PtyHelperSource)')"
           Text="Unix publish requires pty-helper at $(PtyHelperSource)." />
    <Copy Condition="Exists('$(PtyHelperSource)')"
          SourceFiles="$(PtyHelperSource)"
          DestinationFiles="$(PublishDir)pty-helper"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
