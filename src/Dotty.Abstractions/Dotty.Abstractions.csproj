<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Internal contracts shared by the host projects; scripting goes through Lua,
         so this assembly is no longer published as a NuGet package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Themes\themes.json">
      <LogicalName>Dotty.Abstractions.Themes.themes.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
