if (( CURRENT == 2 )) && [[ $words[2] == +* ]]; then
  _describe -t actions 'dotty action' dotty_actions
  return
fi
if [[ $words[2] == +* ]]; then
  case $words[2] in
      +explain-config) _describe -t options 'config option' dotty_config ;;
      +init-config) _values 'flag' --force ;;
      +show-config) _values 'flag' --default ;;
      +diagnose) _values 'flag' --gl ;;
  esac
  return
fi
