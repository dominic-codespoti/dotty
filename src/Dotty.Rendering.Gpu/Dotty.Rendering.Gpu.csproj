<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dotty.Abstractions\Dotty.Abstractions.csproj" />
    <ProjectReference Include="..\Dotty.Terminal\Dotty.Terminal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons\*.svg" LogicalName="Dotty.Rendering.Gpu.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Icons\LICENSE" LogicalName="Dotty.Rendering.Gpu.Icons.LICENSE" />
    <EmbeddedResource Include="Icons\provenance.json" LogicalName="Dotty.Rendering.Gpu.Icons.provenance.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Icons\LICENSE" Link="ThirdParty\Lucide\LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Icons\provenance.json" Link="ThirdParty\Lucide\provenance.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
