<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Internal PTY backends for the Dotty host; no longer published as a NuGet
         package (it depended on Dotty.Abstractions, which is not published either). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- `dotnet publish -c Release` (the shipped artifacts) resolves pty-helper only from the install layout; every
       other build, including Release test and CI builds, may also walk the source tree and PATH (PtyHelperLocator).
       `dotnet publish` sets _IsPublishing as a global property, so referencing projects pass it down. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' And '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);DOTTY_PUBLISHED_LAYOUT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dotty.Abstractions\Dotty.Abstractions.csproj" />
  </ItemGroup>

  <!-- Windows-specific package for P/Invoke -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- On Linux/macOS every build also builds the POSIX pty-helper (bin/pty-helper) with the checked-in Makefile, so a
       fresh clone runs and tests without a manual `make` step. Incremental: skipped while the binary is newer than the
       source. Without a C compiler the build warns instead of failing; `make -C src/Dotty.NativePty` remains the manual
       path. Set DottySkipPtyHelperBuild=true to opt out. -->
  <Target Name="BuildUnixPtyHelper" BeforeTargets="Build"
          Condition="!$([MSBuild]::IsOSPlatform('Windows')) And '$(DottySkipPtyHelperBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/pty-helper.c;$(MSBuildProjectDirectory)/Makefile"
          Outputs="$(MSBuildProjectDirectory)/bin/pty-helper">
    <Exec Command="make -C &quot;$(MSBuildProjectDirectory)&quot;" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
